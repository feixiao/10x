#!/usr/bin/env bash
# ==============================================================================
# .10x/10x - AI-Native 个人超级个体与状态机统合调度器 (集中管理入口)
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 自动定位内部 bin 目录
if [ -d "${SCRIPT_DIR}/bin" ]; then
    BIN_DIR="${SCRIPT_DIR}/bin"
elif [ -d "${SCRIPT_DIR}/scripts" ]; then
    BIN_DIR="${SCRIPT_DIR}/scripts"
else
    BIN_DIR="${SCRIPT_DIR}"
fi

usage() {
    cat <<EOF
10x AI-Native 统一调度中枢 (Non-Intrusive Centralized Edition)

常用指令:
  $0 plan "<宏观大需求>"                       AI 架构师智能拆解大需求为原子切片清单 (大功能必选)
  $0 quick <task-id> "<一句话需求>" [单测命令]   一键生成契约卡并拉起独立车间 (推荐)
  $0 new                                      启动 3 步交互问答向导创建任务
  $0 start <task-id> [单测命令]                启动指定任务的工作车间
  $0 status                                   查看当前所有并发车间、分支与修改状态
  $0 audit <task-id>                          执行双阶段反作弊代码审查 (切分业务与测试)
  $0 close <task-id>                          安全清理已完成的任务车间
  $0 supervisor [step|run|status|unblock|new] 调度方案一多角色主控状态机
  $0 gateway                                  检查本机全局 LiteLLM 网关运行状态

示例:
  $0 quick 101-demo "实现 ETF 溢价率告警" "pytest"
  $0 status
  $0 audit 101-demo
  $0 close 101-demo

查看完整文档:
  less $(dirname "${SCRIPT_DIR}")/.10x/docs/PRACTICAL_WORKFLOW_GUIDE.md 2>/dev/null || true
EOF
    exit 1
}

case "${1:-}" in
    plan)
        shift
        exec python3 "${BIN_DIR}/task_builder.py" plan "$@"
        ;;
    quick|new|wizard|start|status|list|audit|close)
        exec "${BIN_DIR}/solo-worktree.sh" "$@"
        ;;
    supervisor)
        shift
        if [ ! -f "${BIN_DIR}/supervisor.py" ]; then
            echo "⚠️  当前项目采用轻量 Solo 模式安装，未包含 supervisor 状态机。"
            echo "👉 如需使用四角色状态机与安全 MCP 矩阵，请执行: ./install.sh <目标工程> --mode=full"
            exit 1
        fi
        exec python3 "${BIN_DIR}/supervisor.py" "$@"
        ;;
    litellm|gateway)
        echo "--> 正在检查本机全局 LiteLLM 网关 (:4000)..."
        if curl -s -m 1 "http://127.0.0.1:4000/health" >/dev/null 2>&1; then
            echo "✅ 本机全局 LiteLLM 网关运行正常 (http://127.0.0.1:4000)"
        else
            echo "⚠️  未检测到本机运行的 LiteLLM 网关服务，请确保宿主机已开启模型代理 (http://127.0.0.1:4000)"
        fi
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage
        ;;
esac
